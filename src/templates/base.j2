<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="css/styles.css">
    <script>
(() => {
  const root = document.documentElement;
  const themeKey = 'theme';
  const stored = localStorage.getItem(themeKey);

  // Apply stored preference
  if (stored === 'dark') root.classList.add('dark');

  // Sync across multiple tabs
  window.addEventListener('storage', e => {
    if (e.key === themeKey) {
      root.classList.toggle('dark', e.newValue === 'dark');
    }
  });

  // Optional: allow external toggles (dispatch event manually if needed)
  window.addEventListener('theme-toggle', e => {
    const mode = e.detail === 'dark' ? 'dark' : 'light';
    root.classList.toggle('dark', mode === 'dark');
    localStorage.setItem(themeKey, mode);
  });
})();
</script>
  </head>
  <body>
    <!-- CronDNS is no longer maintained: this notice is on every page, on purpose. -->
    <div role="alert" style="background:#b91c1c;color:#fff;padding:20px 24px;text-align:center;font:600 18px/1.45 system-ui,-apple-system,'Segoe UI',sans-serif;border-bottom:4px solid #7f1d1d;">
      <div style="font-size:22px;font-weight:800;letter-spacing:-.01em;">CronDNS is no longer maintained. Please switch to KronDNS.</div>
      <div style="margin-top:6px;font-weight:500;">KronDNS is its successor: a new interface, several users with roles, passkeys and two-factor sign-in, an audit log, backups and more providers. CronDNS gets no further updates or security fixes.</div>
      <a href="https://krondns.net" target="_blank" rel="noopener" style="display:inline-block;margin-top:12px;padding:10px 22px;border-radius:10px;background:#fff;color:#991b1b;text-decoration:none;font-weight:800;">Go to krondns.net</a>
    </div>
    <main>
      {% block content %}{% endblock %}
      {% if cfg.env == 'dev' %}
      <div style="position:fixed; bottom:10px; right:10px;
        padding:2px 8px; border-radius:8px;
        font-size:11px; font-family:monospace;
        background:#fff; color:#555; font-weight:normal;
        border:1px solid #aaa;">
        Build: {{ cfg.build_timestamp }}
      </div>
      {% endif %}
    </main>
    <script>
    {% block scripts %}{% endblock %}

    </script>
  </body>
</html>
